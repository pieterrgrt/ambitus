msgid "Over jou"
msgstr "Über dich"

#: templates/loopbaan/profile.html:17
msgid "Wat je zoekt"
msgstr "Was du suchst"

#: templates/loopbaan/profile.html:24
msgid "Cv"
msgstr "Lebenslauf"
