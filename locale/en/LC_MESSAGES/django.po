#: accounts/views.py:43
msgid ""
"Welkom bij Ambitus! Begin met je profiel, dan kan Ambitus je beter helpen."
msgstr ""
"Welcome to Ambitus! Start with your profile so Ambitus can help you better."

#: accounts/views.py:54 loopbaan/views.py:189 loopbaan/views.py:299
msgid "Opgeslagen."
msgstr "Saved."

#: accounts/views.py:73
msgid "Je account en al je gegevens zijn verwijderd."
msgstr "Your account and all your data have been deleted."

#: accounts/views.py:76
msgid "Typ je e-mailadres precies over om te bevestigen."
msgstr "Type your email address exactly to confirm."

#: accounts/views.py:87
msgid "Uitnodiging gemaakt. Kopieer de link en stuur hem door."
msgstr "Invite created. Copy the link and send it on."

#: loopbaan/forms.py:33
msgid ""
"Beantwoord minstens drie vragen, dan heeft Ambitus genoeg om mee te werken."
msgstr "Answer at least three questions so Ambitus has enough to work with."

#: loopbaan/forms.py:82
msgid "Wensen (optioneel)"
msgstr "Wishes (optional)"

#: loopbaan/forms.py:85
msgid ""
"Bijvoorbeeld: noem mijn stage bij de gemeente, houd het formeel, korter."
msgstr ""
"For example: mention my internship at the city council, keep it formal, "
"shorter."

#: loopbaan/forms.py:102
msgid "Jouw antwoord"
msgstr "Your answer"

#: loopbaan/models.py:15
msgid "Waar sta je nu?"
msgstr "Where are you now?"

#: loopbaan/models.py:17
msgid ""
"Bijvoorbeeld: net afgestudeerd, aan het werk maar wil iets anders, "
"tussenjaar."
msgstr ""
"For example: just graduated, working but want something else, gap year."

#: loopbaan/models.py:19
msgid "Opleiding"
msgstr "Education"

#: loopbaan/models.py:19
msgid "Studies, diploma's, vakken die je goed lagen."
msgstr "Degrees, diplomas, subjects that suited you."

#: loopbaan/models.py:21
msgid "Ervaring"
msgstr "Experience"

#: loopbaan/models.py:21
msgid "Banen, stages, bijbanen, besturen, vrijwilligerswerk."
msgstr "Jobs, internships, side jobs, committee or board work, volunteering."

#: loopbaan/models.py:23
msgid "Waar ben je goed in?"
msgstr "What are you good at?"

#: loopbaan/models.py:24
msgid "Wat interesseert je?"
msgstr "What interests you?"

#: loopbaan/models.py:26
msgid "Wat vind je belangrijk in werk?"
msgstr "What matters to you in work?"

#: loopbaan/models.py:26
msgid "Bijvoorbeeld: zingeving, salaris, vrijheid, een team."
msgstr "For example: meaning, salary, freedom, a team."

#: loopbaan/models.py:28
msgid "Talen die je spreekt"
msgstr "Languages you speak"

#: loopbaan/models.py:30
msgid "Waar wil je werken?"
msgstr "Where do you want to work?"

#: loopbaan/models.py:30
msgid "Steden, landen, of op afstand."
msgstr "Cities, countries, or remote."

#: loopbaan/models.py:33
msgid "Waar moet rekening mee gehouden worden?"
msgstr "What should be taken into account?"

#: loopbaan/models.py:35
msgid "Uren, startdatum, visum, wat je absoluut niet wilt."
msgstr "Hours, start date, visa, what you definitely don't want."

#: loopbaan/models.py:38
msgid "Je cv"
msgstr "Your CV"

#: loopbaan/models.py:38
msgid "Plak hier de tekst van je huidige cv. Opmaak is niet nodig."
msgstr "Paste the text of your current CV here. No formatting needed."

#: loopbaan/models.py:82
msgid "Interessant"
msgstr "Interesting"

#: loopbaan/models.py:83
msgid "Mee bezig"
msgstr "Working on it"

#: loopbaan/models.py:84
msgid "Verstuurd"
msgstr "Sent"

#: loopbaan/models.py:85
msgid "Gesprek"
msgstr "Interview"

#: loopbaan/models.py:86
