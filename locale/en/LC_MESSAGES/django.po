msgstr "Organisation"

#: loopbaan/models.py:94
msgid "Functie"
msgstr "Role"

#: loopbaan/models.py:95
msgid "Link naar de vacature"
msgstr "Link to the job posting"

#: loopbaan/models.py:96
msgid "Plaats"
msgstr "Location"

#: loopbaan/models.py:98 templates/loopbaan/application_detail.html:44
msgid "Vacaturetekst"
msgstr "Job posting"

#: loopbaan/models.py:100
msgid ""
"Plak de vacature hier. Ambitus gebruikt deze tekst voor je brief en je "
"gesprek."
msgstr ""
"Paste the job posting here. Ambitus uses it for your letter and your "
"interview."

#: loopbaan/models.py:102 templates/loopbaan/application_detail.html:10
msgid "Status"
msgstr "Status"

#: loopbaan/models.py:103 templates/loopbaan/application_detail.html:18
msgid "Deadline"
msgstr "Deadline"

#: loopbaan/models.py:104 templates/loopbaan/application_detail.html:17
msgid "Volgende stap"
msgstr "Next step"

#: loopbaan/models.py:105
msgid "Wanneer"
msgstr "When"

#: loopbaan/models.py:106 templates/loopbaan/application_detail.html:19
msgid "Contactpersoon"
msgstr "Contact person"

#: loopbaan/models.py:107
msgid "Notities"
msgstr "Notes"

