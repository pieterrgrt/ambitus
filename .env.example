# Copy to .env and fill in. Never commit .env.

# Make one with: openssl rand -base64 48
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=ambitus.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://ambitus.example.com
# Make one with: openssl rand -hex 24
POSTGRES_PASSWORD=
AMBITUS_PORT=8006
AMBITUS_BASE_URL=https://ambitus.example.com

# Claude API key (console.anthropic.com, API keys)
ANTHROPIC_API_KEY=
# AI actions per user per month; staff accounts are not limited
AMBITUS_AI_MONTHLY_LIMIT=40

# Set to 0 only when the app is reached without HTTPS (for example over Tailscale)
DJANGO_SSL_REDIRECT=1
